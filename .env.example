# ---- StaleCheck API ----
# Where the SQLite database and runtime data live (mount a volume in production).
DATA_DIR=./data

# Optional: require x-api-key on /v1/* routes. Leave empty to disable auth.
API_KEY=

# Comma separated origins, or * for all.
CORS_ORIGINS=*

# live provider: mock | groq | gemini | openai | custom
# Use "gemini" (free tier) or "groq" for live checks; "mock" runs fully offline
# using a bundled freshness snapshot.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# Tavily (free tier: 1,000 searches/month). Leave empty to disable live web checks.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
STALECHECK_URL=http://localhost:8000
STALECHECK_API_KEY=

# Pipeline tuning
MAX_CLAIMS=10
MAX_JUDGED_CLAIMS=6
CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT=30
